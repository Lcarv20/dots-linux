[init]
	defaultBranch = master
[user]
	name = Luís Carvalho
	email = 42584819+Lcarv20@users.noreply.github.com
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[core]
	editor = nvim
	excludesfile = ~/.gitignore_global
	pager = delta
	trustctime = false
	sparseCheckout = true
[diff]
	tool = nvimdiff
	colorMoved = default
[merge]
	tool = nvimdiff
	conflictstyle = diff3
[commit]
	# template = ~/.stCommitMsg
[interactive]
	diffFilter = delta --color-only
[include]
	path = ~/dots-linux/git/themes/themes.gitconfig
[delta]
  ; features = woolly-mammoth
  ; features = calochortus-lyallii
  ; features = mantis-shrimp-lite
  ; features = mellow-barbet
  features = arctic-fox
  ; features = zenburn
  navigate = true  # use n and N to move between diff sections
	side-by-side = true
	line-numbers = true
; [difftool "nvimdiff"]
;   cmd = nvim -d \"$LOCAL\" \"$REMOTE\"
[hub]
	protocol = https
[color]
	ui = true
[color "log"]
	date = normal
	graph = normal
	author = cyan
[credential "https://github.com"]
	helper = 
	helper = !/home/lcarv/.local/share/mise/installs/gh/2.96.0/gh_2.96.0_linux_amd64/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/home/lcarv/.local/share/mise/installs/gh/2.96.0/gh_2.96.0_linux_amd64/bin/gh auth git-credential
[credential]
	helper = store
