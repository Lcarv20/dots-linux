// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "base_keymap": "VSCode",
  "debugger": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "edit_predictions": {
    "mode": "subtle",
  },
  "context_servers": {
    "mcp-server-context7": {
      "settings": {
        "context7_api_key": "ctx7sk-c893041e-ba59-4eef-9cb1-18f9deaf42c0",
      },
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"],
    },
  },
  "tab_bar": {
    "show": true,
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
  },
  "project_panel": {
    "dock": "left",
  },
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "inline_assistant_model": {
      "provider": "google",
      "model": "gemini-2.5-flash",
    },
    "default_profile": "write",
    "default_model": {
      "provider": "mistral",
      "model": "devstral-medium-latest",
    },
  },
  "telemetry": {
    "metrics": true,
  },
  // 🎨 theme settings
  "theme": "XY-Zed",
  // 🖼️ background settings
  "terminal": {
    "dock": "bottom",
    "font_size": 14,
    "font_family": "ComicShannsMono Nerd Font",
    "line_height": { "custom": 1.2 },
    "font_weight": 500,
  },

  // ⚙️ vim settings
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "never",
  },

  // 📈 Diagnostics
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },

  // 🎨 font settings
  // "ui_font_family": "CaskaydiaCove Nerd Font",
  // "buffer_line_height": { "custom": 1.4 },
  "buffer_font_family": "ComicShannsMono Nerd Font",
  "buffer_font_size": 14.0,

  // disable cursor blink
  "cursor_blink": false,
  // "cursor_shape": "hollow",

  // use relative line numbers
  "relative_line_numbers": "wrapped",

  // hide the scroll bar
  "scrollbar": {
    // "show": "never"
    "git_diff": false,
  },
  // allow cursor to reach edges of screen
  "vertical_scroll_margin": 0,
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },

  "lsp": {
    "vscode-css-language-server": {
      "settings": {
        "css": {
          "lint": {
            "unknownAtRules": "ignore",
            // "unknownProperties": "ignore"
          },
        },
      },
    },
  },
}
