# Cursor
# -------------
cursor-style = block
shell-integration-features = no-cursor
# cursor-style-blink = false
cursor-click-to-move = true
cursor-text = #181818
cursor-color = #e86d6d
# cursor-invert-fg-bg
# cursor-color = cyan
# cursor-opacity = 0.7

# Theme
# -------------
theme = Operator Mono Dark

# Cell
# -------------

# # Quick terminal
# keybind = global:cmd+shift+escape=toggle_quick_terminal
# quick-terminal-position = center
# # quick-terminal-size = 20%,20%


# open new tab on dotfiles

# open new tab on home
#--------------
adjust-cell-height = 40%
#--------------

# Font
# -------------
font-family = ComicShannsMono Nerd Font Propo
# font-family = caskaydiaCove NF
font-size = 11
# window-title-font-family = caskaydiaCove NF
#--------------

# Window size
# -------------
window-width = 150
window-height = 50
window-decoration = server
#--------------

# cmd+backspace to delete the entire line
# keybind = super+backspace=text:\x15

# map alt+backspace to delete the word before the cursor
keybind = ctrl+backspace=text:\x17

