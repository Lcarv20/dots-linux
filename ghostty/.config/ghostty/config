# Cursor
# -------------
cursor-style = block
shell-integration-features = no-cursor
# cursor-style-blink = false
cursor-click-to-move = true
# cursor-text = #181818
# cursor-color = #e86d6d

# Theme
# -------------
# theme = Acid Lime
theme = Claude Dark
# theme = Operator Mono Dark
background-opacity = 0.90
background-blur = true

# open new tab on home
#--------------
adjust-cell-height = 40%
#--------------

# Font
# -------------
font-family = ComicShannsMono Nerd Font
# font-family = caskaydiaCove NF
font-size = 11
# window-title-font-family = caskaydiaCove NF
#--------------

# Window size
# -------------
window-width = 150
window-height = 50
window-decoration = none
window-theme = ghostty
#--------------

# Notifications
# -------------
app-notifications=no-clipboard-copy
#--------------

# cmd+backspace to delete the entire line
# keybind = super+backspace=text:\x15

# map alt+backspace to delete the word before the cursor
keybind = ctrl+backspace=text:\x17

